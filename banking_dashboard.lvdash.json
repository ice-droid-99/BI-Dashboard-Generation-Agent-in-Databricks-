{
  "datasets": [
    {
      "name": "ds_transactions_overview",
      "displayName": "Transactions overview",
      "queryLines": [
        "SELECT transaction_date, customer_segment, channel_type, channel_name, MEASURE(`total_transaction_value`) AS total_transaction_value, MEASURE(`transaction_count`) AS transaction_count, MEASURE(`successful_transaction_count`) AS successful_transaction_count, CASE WHEN channel_type = 'Digital' THEN MEASURE(`transaction_count`) ELSE 0 END AS digital_transaction_count, MEASURE(`total_transaction_value`) / 100000.0 AS value_lakhs FROM banking.gold.mv_transactions GROUP BY ALL ORDER BY transaction_date, customer_segment, channel_type, channel_name"
      ]
    },
    {
      "name": "ds_loans_overview",
      "displayName": "Loans overview",
      "queryLines": [
        "SELECT disbursement_date AS transaction_date, customer_segment, loan_status, disbursed_branch AS branch_name, MEASURE(`loan_count`) AS loan_count, MEASURE(`npa_loan_count`) AS npa_loan_count, MEASURE(`total_disbursement`) AS total_disbursement, MEASURE(`total_outstanding_principal`) AS total_outstanding_principal, MEASURE(`npa_outstanding`) AS npa_outstanding FROM banking.gold.mv_loans GROUP BY ALL ORDER BY transaction_date, customer_segment, loan_status, branch_name"
      ]
    },
    {
      "name": "ds_gross_npa_ratio_kpi",
      "displayName": "Gross NPA ratio KPI",
      "queryLines": [
        "SELECT ROUND(SUM(npa_outstanding) / NULLIF(SUM(total_outstanding_principal), 0), 4) AS gross_npa_ratio FROM ( SELECT MEASURE(`total_outstanding_principal`) AS total_outstanding_principal, MEASURE(`npa_outstanding`) AS npa_outstanding, disbursement_date AS transaction_date, customer_segment FROM banking.gold.mv_loans GROUP BY ALL ) loan_kpi_base"
      ]
    },
    {
      "name": "ds_balances_overview",
      "displayName": "Balances overview",
      "queryLines": [
        "WITH monthly_aum AS ( SELECT month_end_date AS transaction_date, month_end_date, customer_segment, MEASURE(`total_closing_balance`) AS total_closing_balance FROM banking.gold.mv_balances GROUP BY ALL ), latest_month AS ( SELECT MAX(month_end_date) AS latest_month_end_date FROM monthly_aum ) SELECT m.transaction_date, m.month_end_date, m.customer_segment, m.total_closing_balance, CASE WHEN m.month_end_date = l.latest_month_end_date THEN m.total_closing_balance ELSE 0 END AS latest_month_closing_balance FROM monthly_aum m CROSS JOIN latest_month l ORDER BY m.month_end_date, m.customer_segment"
      ]
    },
    {
      "name": "ds_holdings_kpi_raw",
      "displayName": "Holdings KPI raw",
      "queryLines": [
        "SELECT ph.acquisition_date AS transaction_date, c.segment AS customer_segment, ph.holding_id, ph.customer_id FROM banking.gold.fact_product_holdings ph JOIN banking.gold.dim_customer c ON ph.customer_id = c.customer_id"
      ]
    },
    {
      "name": "ds_txn_value_by_segment",
      "displayName": "Transaction value by segment",
      "queryLines": [
        "SELECT customer_segment, MEASURE(`total_transaction_value`) AS total_transaction_value FROM banking.gold.mv_transactions GROUP BY ALL ORDER BY total_transaction_value DESC"
      ]
    },
    {
      "name": "ds_holdings_by_product_type",
      "displayName": "Holdings by product type",
      "queryLines": [
        "SELECT product_type, MEASURE(`total_holding_value`) AS total_holding_value, MEASURE(`total_holding_value`) / 100000.0 AS holding_value_lakhs FROM banking.gold.mv_product_holdings GROUP BY ALL ORDER BY total_holding_value DESC"
      ]
    },
    {
      "name": "ds_top_customers",
      "displayName": "Top customers",
      "queryLines": [
        "WITH customer_txn AS ( SELECT c.customer_id, c.full_name, c.segment, COUNT(DISTINCT ft.transaction_id) AS transaction_count, SUM(ft.amount) AS total_transaction_value, ROUND(SUM(ft.amount) / NULLIF(COUNT(DISTINCT ft.transaction_id), 0), 2) AS average_transaction_value FROM banking.gold.fact_transactions ft JOIN banking.gold.dim_customer c ON ft.customer_id = c.customer_id GROUP BY ALL ), grand_total AS ( SELECT SUM(total_transaction_value) AS grand_total_value FROM customer_txn ) SELECT customer_txn.full_name, customer_txn.segment, customer_txn.transaction_count, customer_txn.total_transaction_value, customer_txn.average_transaction_value, customer_txn.total_transaction_value / NULLIF(grand_total.grand_total_value, 0) AS share_of_total FROM customer_txn CROSS JOIN grand_total ORDER BY customer_txn.total_transaction_value DESC LIMIT 10"
      ]
    },
    {
      "name": "ds_branch_loan_portfolio",
      "displayName": "Branch loan portfolio",
      "queryLines": [
        "SELECT disbursed_branch AS branch_name, MEASURE(`loan_count`) AS loan_count, MEASURE(`total_disbursement`) AS total_disbursement, MEASURE(`total_outstanding_principal`) AS total_outstanding_principal, MEASURE(`npa_loan_count`) AS npa_loan_count FROM banking.gold.mv_loans GROUP BY ALL ORDER BY total_disbursement DESC LIMIT 10"
      ]
    }
  ],
